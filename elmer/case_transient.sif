!------------------------------------------------------------------------------
! ELMER FEM SOLVER INPUT FILE (case_transient.sif)
! Hydra-Core: Transient Thermal FEA Simulation in GPU Package Stack
! 4-Layer Stack: Silicon Die | TIM-1 | PCM Buffer | Copper Cold Plate
! ------------------------------------------------------------------------------

Header
  CHECK KEYWORDS Warn
  Mesh DB "." "elmer_mesh"
  Include Path ""
  Results Directory "elmer_results"
End

Simulation
  Max Output Level = 4
  Coordinate System = Cartesian 2D
  Coordinate Mapping(3) = 1 2 3
  Simulation Type = Transient
  Timestepping Method = BDF
  BDF Order = 2
  Timestep Intervals = 40
  Timestep Sizes = 0.5
  Steady State Max Iterations = 1
  Output File = "transient.result"
  Post File = "transient.vtu"
End

Constants
  Stefan Boltzmann = 5.67e-08
End

!--- Bodies (4 layers) ---

Body 1
  Target Bodies(1) = 1
  Name = "GPU_Die"
  Equation = 1
  Material = 1
  Body Force = 1
End

Body 2
  Target Bodies(1) = 2
  Name = "TIM_Layer"
  Equation = 1
  Material = 2
End

Body 3
  Target Bodies(1) = 3
  Name = "PCM_Buffer"
  Equation = 1
  Material = 3
End

Body 4
  Target Bodies(1) = 4
  Name = "Cold_Plate"
  Equation = 1
  Material = 4
End

!--- Equation ---

Equation 1
  Name = "Heat_Equation"
  Active Solvers(1) = 1
End

!--- Solver: HeatSolve ---

Solver 1
  Equation = Heat Equation
  Variable = Temperature
  Procedure = "HeatSolve" "HeatSolver"
  Exec Solver = Always
  Stabilize = True
  Optimize Bandwidth = True
  Steady State Convergence Tolerance = 1.0e-5
  Nonlinear System Convergence Tolerance = 1.0e-5
  Nonlinear System Max Iterations = 20
  Nonlinear System Newton After Iterations = 3
  Nonlinear System Newton After Tolerance = 1.0e-3
  Nonlinear System Relaxation Factor = 1.0
  Linear System Solver = Iterative
  Linear System Iterative Method = BiCGStabl
  Linear System Max Iterations = 500
  Linear System Convergence Tolerance = 1.0e-8
  Linear System Preconditioning = ILU1
  Linear System Abort Not Converged = False
End

!--- Materials ---

! Material 1: Silicon GPU Die
Material 1
  Name = "Silicon"
  Density = Real 2330.0
  Heat Capacity = Real 700.0
  Heat Conductivity = Real 130.0
End

! Material 2: Thermal Interface Material (TIM)
Material 2
  Name = "TIM"
  Density = Real 2500.0
  Heat Capacity = Real 500.0
  Heat Conductivity = Real 15.0
End

! Material 3: Composite PCM Buffer (Hydra-Core)
Material 3
  Name = "Composite_PCM"
  Density = Real 1200.0
  Heat Capacity = Real 1800.0
  Heat Conductivity = Real 110.0
End

! Material 4: Copper Cold Plate
Material 4
  Name = "Copper"
  Density = Real 8960.0
  Heat Capacity = Real 385.0
  Heat Conductivity = Real 400.0
End

!--- Body Force: Volumetric Heat Source in GPU Die ---
! Heat Source in Elmer is W/kg: Q_vol / rho = (8.764e8 W/m^3) / (2330 kg/m^3) = 3.761373e5 W/kg
Body Force 1
  Name = "GPU_Heat_Source"
  Heat Source = Real 3.761373e5
End

!--- Boundary Conditions ---

! BC 1: Top surface - Microchannel liquid cooling convection
Boundary Condition 1
  Target Boundaries(1) = 1
  Name = "Coolant_Top"
  Heat Transfer Coefficient = Real 35000.0
  External Temperature = Real 25.0
End

! BC 2: Bottom surface - Insulated (adiabatic)
Boundary Condition 2
  Target Boundaries(1) = 2
  Name = "Bottom_Insulated"
  Heat Flux = Real 0.0
End

! BC 3: Left side - Insulated (symmetry)
Boundary Condition 3
  Target Boundaries(1) = 3
  Name = "Left_Side"
  Heat Flux = Real 0.0
End

! BC 4: Right side - Insulated (symmetry)
Boundary Condition 4
  Target Boundaries(1) = 4
  Name = "Right_Side"
  Heat Flux = Real 0.0
End
